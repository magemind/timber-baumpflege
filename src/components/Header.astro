---
import { CONTACT, waLink } from '../config';
const currentPath = Astro.url.pathname;

const navItems = [
  { label: 'Team', href: '/team/' },
  { label: 'Leistungen', href: '/leistungen/' },
  { label: 'Preisrechner', href: '/preisrechner/' },
  { label: 'Wissen', href: '/wissen/' },
  { label: 'Einsatztypen', href: '/referenzen/' },
  { label: 'Kontakt', href: '/kontakt/' },
];
---

<header class="fixed top-0 left-0 right-0 z-50 bg-birke/95 backdrop-blur-md border-b border-linie" id="site-header">
  <div class="container-site flex items-center justify-between h-[74px]">
    <a href="/" class="flex items-center gap-2.5 no-underline group" aria-label="TIMBER Startseite">
      <svg width="34" height="34" viewBox="0 0 32 32" fill="none" aria-hidden="true">
        <rect width="32" height="32" rx="4" fill="#1B2A20"/>
        <path d="M16 5 L10 12 L13 12 L8 20 L12 20 L6 28 L26 28 L20 20 L24 20 L19 12 L22 12 Z" fill="#C9A34E"/>
        <rect x="14" y="26" width="4" height="4" fill="#5C4033"/>
      </svg>
      <div class="flex flex-col leading-none">
        <span class="font-display font-semibold text-[1.35rem] text-forst tracking-tight">TIMBER</span>
        <span class="text-[0.68rem] tracking-[0.2em] uppercase text-rauch mt-1">Baumpflege & Baumdienst</span>
      </div>
    </a>

    <nav class="hidden lg:flex items-center gap-1" aria-label="Hauptnavigation">
      {navItems.map((item) => (
        <a
          href={item.href}
          class:list={[
            'px-3.5 py-2 text-[0.925rem] font-medium transition-colors no-underline tracking-wide',
            currentPath === item.href
              ? 'text-forst border-b-2 border-messing'
              : 'text-tinte/70 hover:text-forst'
          ]}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-3">
      <a href={waLink()} class="hidden sm:inline-flex btn-messing !py-2.5 !px-5 text-[0.925rem]" target="_blank" rel="noopener"><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.66 15.03L2 22l5.14-1.35A10 10 0 1 0 12 2Zm0 18.18a8.14 8.14 0 0 1-4.16-1.14l-.3-.18-3.06.8.82-2.98-.2-.31A8.18 8.18 0 1 1 12 20.18Zm4.71-6.14c-.26-.13-1.54-.76-1.78-.85-.24-.09-.41-.13-.58.13-.17.26-.66.85-.81 1.02-.15.17-.3.19-.55.06-.26-.13-1.1-.4-2.09-1.28-.77-.68-1.28-1.53-1.44-1.79-.15-.26-.02-.4.11-.53.11-.11.26-.3.39-.44.13-.15.17-.26.26-.43.09-.17.04-.32-.02-.45-.06-.13-.58-1.4-.79-1.92-.21-.5-.42-.44-.58-.44l-.5-.01c-.17 0-.44.06-.67.32-.23.26-.88.86-.88 2.1s.9 2.43 1.03 2.6c.13.17 1.78 2.72 4.32 3.81.6.26 1.08.41 1.45.53.61.19 1.16.17 1.6.1.49-.07 1.54-.63 1.75-1.24.22-.61.22-1.13.15-1.24-.07-.11-.24-.17-.5-.3Z"/></svg> Foto senden</a>

      <button
        id="mobile-toggle"
        class="lg:hidden flex flex-col justify-center items-center w-11 h-11 gap-1.5"
        aria-label="Menü öffnen"
        aria-expanded="false"
      >
        <span class="block w-6 h-[1.5px] bg-forst transition-all duration-300" id="burger-top"></span>
        <span class="block w-6 h-[1.5px] bg-forst transition-all duration-300" id="burger-mid"></span>
        <span class="block w-6 h-[1.5px] bg-forst transition-all duration-300" id="burger-bot"></span>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="lg:hidden hidden bg-birke border-t border-linie max-h-[calc(100dvh-74px)] overflow-y-auto">
    <nav class="container-site py-6 flex flex-col gap-1" aria-label="Mobile Navigation">
      {navItems.map((item) => (
        <a href={item.href} class="block py-3 px-3 text-tinte font-medium no-underline hover:text-messing-dark transition-colors border-b border-linie/50 last:border-0">
          {item.label}
        </a>
      ))}
      <a href={waLink()} class="btn-primary text-center justify-center mt-4" target="_blank" rel="noopener">Foto per WhatsApp senden</a>
      <a href={`tel:${CONTACT.phone}`} class="text-center text-sm text-rauch no-underline mt-2">Notfall: ☎ {CONTACT.phoneDisplay}</a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('mobile-toggle');
  const menu = document.getElementById('mobile-menu');
  const top = document.getElementById('burger-top');
  const mid = document.getElementById('burger-mid');
  const bot = document.getElementById('burger-bot');
  toggle?.addEventListener('click', () => {
    const open = menu?.classList.toggle('hidden') === false;
    toggle.setAttribute('aria-expanded', String(open));
    if (top && mid && bot) {
      top.style.transform = open ? 'rotate(45deg) translate(4px, 4px)' : '';
      mid.style.opacity = open ? '0' : '1';
      bot.style.transform = open ? 'rotate(-45deg) translate(4px, -4px)' : '';
    }
  });
</script>
