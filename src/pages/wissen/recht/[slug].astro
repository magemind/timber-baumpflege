---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { CONTACT, waLink, mailB64 } from '../../../config';
import { RECHT } from '../../../content/recht';

export async function getStaticPaths() {
  return RECHT.map((r) => ({ params: { slug: r.slug } }));
}

const { slug } = Astro.params;
const article = RECHT.find((r) => r.slug === slug)!;
const others = RECHT.filter((r) => r.slug !== slug);
---

<BaseLayout title={`${article.title} — TIMBER Baumpflege`} description={article.meta}>

  <!-- HERO -->
  <section class="bg-forst-dark text-birke">
    <div class="container-narrow section-padding-sm">
      <nav class="text-caption text-birke/60 mb-4">
        <a href="/" class="hover:text-messing no-underline">Start</a> ·
        <a href="/wissen/" class="hover:text-messing no-underline">Wissen</a> ·
        <a href="/wissen/recht/" class="hover:text-messing no-underline">Recht &amp; Genehmigung</a> ·
        <span class="text-birke">{article.title}</span>
      </nav>
      <span class="eyebrow text-messing">Deep-Dive · Recht &amp; Genehmigung</span>
      <h1 class="mt-4 text-birke leading-[1.05]">{article.title}</h1>
      <p class="mt-8 text-body-lg text-birke/75 leading-relaxed">{article.short}</p>
    </div>
  </section>

  <!-- STECKBRIEF -->
  <section class="bg-forst border-y border-birke/10">
    <div class="container-narrow py-8">
      <dl class="grid gap-3 md:grid-cols-2 text-caption text-birke/85">
        <div>
          <dt class="text-messing font-semibold uppercase tracking-widest text-[0.7rem]">Rechtsgrundlage</dt>
          <dd class="mt-1">{article.hero.rechtsgrundlage}</dd>
        </div>
        <div>
          <dt class="text-messing font-semibold uppercase tracking-widest text-[0.7rem]">Zuständigkeit</dt>
          <dd class="mt-1">{article.hero.zustaendigkeit}</dd>
        </div>
        <div>
          <dt class="text-messing font-semibold uppercase tracking-widest text-[0.7rem]">Frist / Zeitrahmen</dt>
          <dd class="mt-1">{article.hero.frist}</dd>
        </div>
        <div>
          <dt class="text-messing font-semibold uppercase tracking-widest text-[0.7rem]">Konsequenz bei Verstoß</dt>
          <dd class="mt-1">{article.hero.konsequenz}</dd>
        </div>
      </dl>
    </div>
  </section>

  <!-- ARTIKEL -->
  <article class="section-padding">
    <div class="container-narrow prose">
      <p class="lead">{article.intro}</p>

      {article.sections.map((s) => (
        <>
          <h2>{s.h}</h2>
          {s.p.map((para) => <p>{para}</p>)}
        </>
      ))}

      <h2>Fazit</h2>
      <p><strong>{article.fazit}</strong></p>
    </div>
  </article>

  <!-- KONTAKT-CTA -->
  <section class="section-padding-sm bg-birke-dark border-y border-linie">
    <div class="container-narrow text-center">
      <h2 class="text-forst">Konkreten Fall besprechen?</h2>
      <p class="mt-6 text-body-lg text-tinte/75">Foto per WhatsApp oder E-Mail — ein Ansprechpartner, keine Warteschleife.</p>
      <div class="mt-10 flex flex-wrap gap-4 justify-center">
        <a href={waLink()} class="btn-primary" target="_blank" rel="noopener"><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.66 15.03L2 22l5.14-1.35A10 10 0 1 0 12 2Zm0 18.18a8.14 8.14 0 0 1-4.16-1.14l-.3-.18-3.06.8.82-2.98-.2-.31A8.18 8.18 0 1 1 12 20.18Zm4.71-6.14c-.26-.13-1.54-.76-1.78-.85-.24-.09-.41-.13-.58.13-.17.26-.66.85-.81 1.02-.15.17-.3.19-.55.06-.26-.13-1.1-.4-2.09-1.28-.77-.68-1.28-1.53-1.44-1.79-.15-.26-.02-.4.11-.53.11-.11.26-.3.39-.44.13-.15.17-.26.26-.43.09-.17.04-.32-.02-.45-.06-.13-.58-1.4-.79-1.92-.21-.5-.42-.44-.58-.44l-.5-.01c-.17 0-.44.06-.67.32-.23.26-.88.86-.88 2.1s.9 2.43 1.03 2.6c.13.17 1.78 2.72 4.32 3.81.6.26 1.08.41 1.45.53.61.19 1.16.17 1.6.1.49-.07 1.54-.63 1.75-1.24.22-.61.22-1.13.15-1.24-.07-.11-.24-.17-.5-.3Z"/></svg> Fotos per WhatsApp</a>
        <a data-mb={mailB64()} href="/kontakt/" class="btn-ghost"><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M4 6h16a2 2 0 0 1 2 2v.4l-10 5.6L2 8.4V8a2 2 0 0 1 2-2zm18 4.35V18a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2v-7.65l10 5.62 10-5.62z"/></svg> Fotos per E-Mail</a>
      </div>
    </div>
  </section>

  <!-- WEITERE ARTIKEL -->
  <section class="section-padding">
    <div class="container-site">
      <span class="eyebrow text-moos">Weiter im Cluster</span>
      <h2 class="mt-4 text-forst">Andere rechtliche Themen</h2>
      <div class="mt-10 grid gap-6 md:grid-cols-3">
        {others.map((r) => (
          <a href={`/wissen/recht/${r.slug}/`} class="group block panel no-underline">
            <h3 class="text-forst group-hover:text-messing-dark transition-colors" style="font-size: 1.25rem; line-height: 1.2;">{r.title}</h3>
            <p class="mt-3 text-body-sm text-rauch leading-relaxed">{r.short}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

</BaseLayout>
