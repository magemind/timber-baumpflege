---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { CONTACT, WISSEN, WISSEN_KATEGORIEN } from '../../config';
---

<BaseLayout
  title="Wissen · Ratgeber zu Baumpflege, Fällung, Recht und Handwerk"
  description="Fachliche Ratgeber-Artikel von TIMBER Baumpflege & Baumdienst — Seilklettertechnik, Verkehrssicherungspflicht, Kronensicherung, Sturmschaden und mehr. Aus der Krone, nicht aus der Broschüre."
>

  <!-- HERO -->
  <section class="bg-forst-dark text-birke">
    <div class="container-site section-padding-sm">
      <span class="eyebrow text-messing">Wissen</span>
      <h1 class="mt-4 text-birke max-w-3xl leading-[1.05]">Aus der Krone, nicht aus der Broschüre.</h1>
      <p class="mt-8 text-body-lg text-birke/70 max-w-2xl leading-relaxed">
        Was ein Kunde vor dem Anruf wissen sollte — was SKT-B eigentlich heißt,
        wann Winterschnitt Pflicht ist, wer bei einem herabfallenden Ast haftet.
        Kein Verkaufsgeschwätz. Was in der Praxis gilt.
      </p>
    </div>
  </section>

  <!-- KATEGORIEN-HUB -->
  <section class="section-padding">
    <div class="container-site">
      <span class="eyebrow text-moos">Themen-Cluster</span>
      <h2 class="mt-4 text-forst max-w-3xl">Fünf große Felder — vertieft statt überflogen.</h2>
      <p class="mt-6 text-body-lg text-rauch max-w-2xl leading-relaxed">
        Für jede Kategorie eine eigene Landing mit fachlichen Deep-Dive-Artikeln.
        Baumkrankheiten, Baumarten und Recht &amp; Genehmigung stehen komplett — die
        weiteren Cluster folgen laufend.
      </p>

      <div class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {WISSEN_KATEGORIEN.map((k) => (
          k.status === 'live' ? (
            <a href={`/wissen/${k.slug}/`} class="group block panel no-underline">
              <span class="rule"></span>
              <span class="text-caption text-moos font-semibold uppercase tracking-widest">Cluster</span>
              <h3 class="mt-3 text-forst group-hover:text-messing-dark transition-colors" style="font-size: 1.35rem;">{k.name}</h3>
              <p class="mt-4 text-body text-rauch leading-relaxed">{k.kurz}</p>
              <span class="mt-6 inline-block text-caption text-moos font-semibold uppercase tracking-widest group-hover:text-messing-dark transition-colors">Zum Cluster →</span>
            </a>
          ) : (
            <div class="block panel opacity-60" style="border-style: dashed;">
              <span class="text-caption text-rauch font-semibold uppercase tracking-widest">In Vorbereitung</span>
              <h3 class="mt-3 text-forst" style="font-size: 1.35rem;">{k.name}</h3>
              <p class="mt-4 text-body text-rauch leading-relaxed">{k.kurz}</p>
              <span class="mt-6 inline-block text-caption text-rauch font-semibold uppercase tracking-widest">Folgt in Kürze</span>
            </div>
          )
        ))}
      </div>
    </div>
  </section>

  <!-- EINZELRATGEBER -->
  <section class="section-padding bg-birke-dark border-y border-linie">
    <div class="container-site">
      <span class="eyebrow text-moos">Einzelratgeber</span>
      <h2 class="mt-4 text-forst max-w-3xl">Kurze Antworten auf die häufigsten Fragen.</h2>
      <p class="mt-6 text-body-lg text-rauch max-w-2xl leading-relaxed">
        Was SKT-B heißt, wann Winterschnitt Pflicht ist, wer bei einem herabfallenden Ast haftet —
        die überregionalen Basis-Ratgeber.
      </p>

      <div class="mt-12 grid gap-6 md:grid-cols-2">
        {WISSEN.map((w) => (
          <a href={`/wissen/${w.slug}/`} class="group block panel no-underline">
            <span class="rule"></span>
            <h3 class="text-forst group-hover:text-messing-dark transition-colors" style="font-size: 1.5rem;">{w.title}</h3>
            <p class="mt-4 text-body text-rauch leading-relaxed">{w.short}</p>
            <span class="mt-6 inline-block text-caption text-moos font-semibold uppercase tracking-widest group-hover:text-messing-dark transition-colors">Weiterlesen →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ZWECK-ERKLÄRUNG -->
  <section class="section-padding bg-birke-dark border-y border-linie">
    <div class="container-narrow">
      <span class="eyebrow">Warum diese Seite</span>
      <h2 class="mt-4">Baumpflege ist erklärungsbedürftig.</h2>
      <div class="prose mt-8">
        <p>
          Die meisten Kunden hören zum ersten Mal von „SKT-A", „Kronensicherung"
          oder „FLL-Baumkontrollrichtlinie" genau dann, wenn ein Baum ein Problem geworden
          ist — und dann muss es schnell gehen. In der Eile werden Angebote verglichen, die
          nicht vergleichbar sind, weil die dahinter liegenden Leistungen fundamental
          unterschiedlich sind.
        </p>
        <p>
          Deshalb schreiben wir das hier auf. Nicht als Werbung, sondern als das, was wir
          jedem Kunden am Telefon ohnehin erklären. Wenn Du danach noch Fragen hast:
          direkter Draht ins Team, {CONTACT.phoneDisplay}.
        </p>
      </div>
    </div>
  </section>

</BaseLayout>
