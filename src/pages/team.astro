---
import BaseLayout from '../layouts/BaseLayout.astro';
import { CONTACT, TEAM, TEAM_QUALIFIKATIONEN } from '../config';
---

<BaseLayout
  title="Team · Kernteam und Fachpartner"
  description="TIMBER ist ein festes Kernteam mit SKT-A-Kletterei plus ein eingespielter Kreis freier Fachpartner (SKT-B, Fachagrarwirt Baumpflege, Motorsägenlehrgänge). Nachweise der eingesetzten Fachkräfte auf Anforderung."
>

  <!-- HERO -->
  <section class="bg-forst-dark text-birke">
    <div class="container-site section-padding-sm">
      <span class="eyebrow text-messing">Team</span>
      <h1 class="mt-4 text-birke max-w-3xl leading-[1.05]">{TEAM.headline}</h1>
      <p class="mt-8 text-body-lg text-birke/70 max-w-2xl leading-relaxed">{TEAM.intro}</p>
    </div>
  </section>

  <!-- MODELL -->
  <section class="section-padding">
    <div class="container-site grid gap-14 lg:grid-cols-[1fr_1.3fr]">

      <div>
        <span class="eyebrow">Warum kein Solo-Betrieb</span>
        <h2 class="mt-4">Baum­pflege ist Teamarbeit.</h2>
      </div>

      <div class="prose">
        <p>
          Auf jedem seriösen Einsatz stehen mindestens zwei Fachkräfte: einer im Baum, einer
          am Boden mit Kommunikation, Absicherung und Bergung. Für schwierige Fällungen kommen
          Kran- oder MEWP-Führer dazu, für Gutachten der Fachagrarwirt, für großflächige
          Aufarbeitung der Trecker- oder Rückefahrzeug-Führer.
        </p>
        <p>
          Ein einzelner Baumpfleger — auch mit sämtlichen Zertifikaten — kann das nicht
          leisten. Deshalb arbeitet TIMBER mit einem festen Kernteam plus einem eingespielten
          Kreis freier Fachpartner, die zusammen die vollständige Qualifikations-Bandbreite
          abdecken. Wer aufs Grundstück kommt, hat für die konkrete Aufgabe die passenden
          Nachweise dabei.
        </p>
        <p>{TEAM.fokus}</p>
      </div>
    </div>
  </section>

  <!-- QUALIFIKATIONEN -->
  <section class="section-padding bg-birke-dark border-y border-linie">
    <div class="container-site">
      <div class="max-w-2xl">
        <span class="eyebrow">Qualifikationen</span>
        <h2 class="mt-4">Was im Team vorhanden ist.</h2>
        <p class="mt-6 text-body-lg text-tinte/75 leading-relaxed">
          Die folgenden Nachweise werden je nach Einsatz aus Kernteam und Fachpartnern
          abgerufen. Zertifikat-Nachweise der jeweils eingesetzten Fachkräfte werden auf
          Anforderung vor Auftragsstart vorgelegt — für Verwalter, Wohnungsgesellschaften
          und öffentliche Auftraggeber ist das ohnehin Standard.
        </p>
      </div>

      <div class="mt-12">
        <div class="text-caption uppercase tracking-widest text-messing-dark mb-6">Im Team vorhanden</div>
        <div class="grid gap-4 md:grid-cols-2">
          {TEAM_QUALIFIKATIONEN.map((q) => (
            <div class="panel flex items-start gap-4">
              <svg class="w-6 h-6 shrink-0 mt-1 text-messing" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              <span class="text-body text-forst font-medium">{q}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- WERTE -->
  <section class="section-padding">
    <div class="container-site">
      <div class="max-w-2xl">
        <span class="eyebrow">Was uns leitet</span>
        <h2 class="mt-4">Drei Prinzipien.</h2>
      </div>

      <div class="mt-14 grid gap-8 md:grid-cols-3">
        <div>
          <div class="font-display text-6xl text-messing italic">01</div>
          <h3 class="mt-4 text-forst" style="font-size: 1.375rem;">Erhalt vor Ersatz</h3>
          <p class="mt-3 text-body-sm text-rauch leading-relaxed">Kronenpflege, Kronensicherung, Sicherungsschnitt zuerst. Fällung erst, wenn der Baum nicht mehr sicher gehalten werden kann. Nachhaltig — und meist auch günstiger.</p>
        </div>
        <div>
          <div class="font-display text-6xl text-messing italic">02</div>
          <h3 class="mt-4 text-forst" style="font-size: 1.375rem;">Handwerk vor Preisdumping</h3>
          <p class="mt-3 text-body-sm text-rauch leading-relaxed">Wir sind nicht die günstigsten. Wir sind zertifiziert, versichert und arbeiten mit sauberer Ausrüstung. Dumping-Angebote ohne Nachweise fallen bei uns durch — und im Zweifel bei der Versicherung ebenfalls.</p>
        </div>
        <div>
          <div class="font-display text-6xl text-messing italic">03</div>
          <h3 class="mt-4 text-forst" style="font-size: 1.375rem;">Regional statt landesweit</h3>
          <p class="mt-3 text-body-sm text-rauch leading-relaxed">Wir arbeiten dort, wo wir die Kommunen kennen. Kein Kolonial-Vertrieb quer durch Norddeutschland — dafür lokal verwurzelt in unseren Einsatzgebieten.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- KONTAKT -->
  <section class="section-padding-sm bg-forst-dark text-birke">
    <div class="container-narrow text-center">
      <h2 class="text-birke">Direkter Draht ins Team.</h2>
      <p class="mt-6 text-body-lg text-birke/75">Keine Warteschleife, keine Vermittlung. Kurzer Draht in die Krone.</p>
      <div class="mt-10 flex flex-wrap gap-4 justify-center">
        <a href={`tel:${CONTACT.phone}`} class="btn-messing">☎ {CONTACT.phoneDisplay}</a>
        <a href="/kontakt/" class="btn-ghost border-birke/40 text-birke hover:bg-birke hover:text-forst">Formular →</a>
      </div>
    </div>
  </section>

</BaseLayout>
