---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProtectedEmail from '../components/ProtectedEmail.astro';
import { SITE, CONTACT, waLink } from '../config';

const mailActionB64 = Buffer.from('mailto:' + CONTACT.email).toString('base64');
---

<BaseLayout
  title="Kontakt"
  description={`Kontakt zu ${SITE.legalName}: Fotos per WhatsApp oder E-Mail, Telefon für Notfälle. Fotos per WhatsApp oder E-Mail — ein Ansprechpartner.`}
>

  <section class="bg-forst-dark text-birke">
    <div class="container-site section-padding-sm">
      <span class="eyebrow text-messing">Kontakt</span>
      <h1 class="mt-4 text-birke max-w-3xl leading-[1.05]">Direkter Draht zu uns.</h1>
      <p class="mt-8 text-body-lg text-birke/70 max-w-2xl leading-relaxed">
        Keine Warteschleife: Schreibe uns per WhatsApp oder E-Mail – gern mit Fotos vom Baum – oder rufe an. Wir melden uns meist innerhalb eines Werktags, im Sturmfall sofort.
      </p>
    </div>
  </section>

  <section class="section-padding">
    <div class="container-site grid gap-14 lg:grid-cols-[1.2fr_1fr]">

      <!-- CONTACT CARDS -->
      <div class="grid gap-4 sm:grid-cols-2 self-start">
        <a href={waLink()} target="_blank" rel="noopener" class="panel group no-underline">
          <div class="text-caption uppercase tracking-widest text-messing-dark">Kontakt per WhatsApp</div>
          <div class="mt-3 font-display text-2xl text-forst group-hover:text-messing-dark transition-colors">Chat</div>
          <p class="mt-3 text-body-sm text-rauch">Am schnellsten – Fotos gern dazu</p>
        </a>
        <a href={`tel:${CONTACT.phone}`} class="panel group no-underline">
          <div class="text-caption uppercase tracking-widest text-messing-dark">Telefon · Notfälle</div>
          <div class="mt-3 font-display text-2xl text-forst group-hover:text-messing-dark transition-colors">{CONTACT.phoneDisplay}</div>
          <p class="mt-3 text-body-sm text-rauch">Für Eiliges &amp; Sturmschäden · 24/7 Notdienst</p>
        </a>
        <div class="panel">
          <div class="text-caption uppercase tracking-widest text-messing-dark">Kontakt per E-Mail</div>
          <div class="mt-3 font-display text-lg text-forst"><ProtectedEmail /></div>
          <p class="mt-3 text-body-sm text-rauch">Antwort innerhalb eines Werktags</p>
        </div>
        <div class="panel">
          <div class="text-caption uppercase tracking-widest text-messing-dark">Anschrift</div>
          <div class="mt-3 font-display text-lg text-forst leading-tight">
            {SITE.legalName}<br/>
            {CONTACT.street}<br/>
            {CONTACT.zip} {CONTACT.city}
          </div>
        </div>
      </div>

      <!-- FORM -->
      <form
        id="contact-form"
        method="post"
        class="panel space-y-5"
        data-timber-anfrage
      >
        <div>
          <span class="eyebrow">Nachricht</span>
          <h2 class="mt-3" style="font-size: 1.75rem;">Schreib uns.</h2>
        </div>

        <label class="block">
          <span class="text-caption uppercase tracking-widest text-rauch">Name</span>
          <input type="text" name="name" required class="mt-1 w-full border border-linie bg-birke px-4 py-3 text-body focus:border-moos focus:outline-none transition-colors" />
        </label>

        <label class="block">
          <span class="text-caption uppercase tracking-widest text-rauch">Telefon oder E-Mail</span>
          <input type="text" name="kontakt" required class="mt-1 w-full border border-linie bg-birke px-4 py-3 text-body focus:border-moos focus:outline-none transition-colors" />
        </label>

        <label class="block">
          <span class="text-caption uppercase tracking-widest text-rauch">Standort (PLZ oder Ort)</span>
          <input type="text" name="ort" class="mt-1 w-full border border-linie bg-birke px-4 py-3 text-body focus:border-moos focus:outline-none transition-colors" />
        </label>

        <label class="block">
          <span class="text-caption uppercase tracking-widest text-rauch">Deine Nachricht</span>
          <textarea name="nachricht" required rows="5" class="mt-1 w-full border border-linie bg-birke px-4 py-3 text-body focus:border-moos focus:outline-none transition-colors resize-y"></textarea>
        </label>

        <button type="submit" class="btn-primary w-full justify-center">Nachricht senden</button>
      </form>
    </div>
  </section>


  <script is:inline src="https://serp-ecru.vercel.app/anfrage.js" defer></script>
</BaseLayout>
