---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE, CONTACT, LEISTUNGEN, EINSATZTYPEN, WISSEN, STAEDTE } from '../config';
---

<BaseLayout title="Startseite" description={SITE.description}>

  <!-- HERO -->
  <section class="relative bg-forst-dark text-birke overflow-hidden">
    <div class="absolute inset-0 opacity-[0.04]" style="background-image: radial-gradient(circle at 30% 40%, #C9A34E 0%, transparent 50%);"></div>
    <div class="container-site relative section-padding grid gap-14 lg:grid-cols-[1.15fr_1fr] lg:items-center">
      <div>
        <span class="eyebrow text-messing">Baumpflege & Baumdienst · Norddeutschland</span>
        <h1 class="mt-6 text-birke leading-[1.05]">Handwerk mit Höhe.<br/><span class="text-messing italic font-normal">Bäume, die bleiben.</span></h1>
        <p class="mt-8 text-body-lg text-birke/75 max-w-xl leading-relaxed">
          TIMBER ist ein Team aus <strong class="text-birke">zertifizierten Baumkletterern und Fachagrarwirten</strong> in Norddeutschland. Wir arbeiten dort, wo kein Kran hinkommt, und pflegen Bäume so, dass sie stehen bleiben können.
        </p>
        <div class="mt-10 flex flex-wrap gap-4">
          <a href={`tel:${CONTACT.phone}`} class="btn-messing">☎ {CONTACT.phoneDisplay}</a>
          <a href="/preisrechner/" class="btn-ghost border-birke/40 text-birke hover:bg-birke hover:text-forst">Preis schätzen →</a>
        </div>
        <div class="mt-10 flex flex-wrap gap-x-8 gap-y-3 text-caption text-birke/60 uppercase tracking-widest">
          <span>SKT-A/B im Team</span>
          <span>·</span>
          <span>ZTV-Baumpflege</span>
          <span>·</span>
          <span>Vollversichert</span>
        </div>
      </div>

      <div class="relative">
        <div class="aspect-[4/5] bg-gradient-to-br from-forst-light to-forst border border-birke/10 rounded-sm relative overflow-hidden">
          <svg class="absolute inset-0 w-full h-full opacity-30" viewBox="0 0 400 500" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
            <defs>
              <linearGradient id="treegrad" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0" stop-color="#C9A34E" stop-opacity="0.6"/>
                <stop offset="1" stop-color="#5C4033" stop-opacity="0.9"/>
              </linearGradient>
            </defs>
            <path d="M200 80 C170 100, 140 130, 130 180 C100 190, 80 220, 90 260 C60 280, 55 320, 90 340 C110 370, 150 380, 200 380 C250 380, 290 370, 310 340 C345 320, 340 280, 310 260 C320 220, 300 190, 270 180 C260 130, 230 100, 200 80 Z" fill="url(#treegrad)"/>
            <rect x="190" y="380" width="20" height="80" fill="#5C4033"/>
          </svg>
          <div class="absolute inset-0 flex items-end p-8">
            <blockquote class="text-birke/90 font-display italic text-2xl leading-tight">„Ein guter Baum wird nicht ersetzt — er wird gepflegt."</blockquote>
          </div>
        </div>
        <div class="absolute -bottom-6 -left-6 bg-messing text-forst-dark px-5 py-3 font-display text-sm shadow-xl">
          <div class="font-semibold">Zertifiziertes Team</div>
          <div class="text-caption opacity-80">SKT-A/B · ZTV-Baumpflege</div>
        </div>
      </div>
    </div>
  </section>

  <!-- 60-SEK-EINSCHÄTZUNG -->
  <section class="section-padding-sm">
    <div class="container-site">
      <div class="max-w-3xl mx-auto panel">
        <span class="eyebrow">Vier Etappen</span>
        <h2 class="mt-3" style="font-size: 1.85rem;">Vom Erstkontakt bis zur besenreinen Fläche</h2>
        <ol class="mt-6 space-y-4 text-body-sm text-forst-dark">
          <li class="flex gap-4"><span class="flex-none w-8 h-8 rounded-full bg-messing text-forst-dark font-semibold flex items-center justify-center">1</span><span><strong class="text-forst">Kurze Bild-Nachricht per WhatsApp</strong> — Baum, Standort, was Du beobachtest. Ein Satz plus zwei Fotos.</span></li>
          <li class="flex gap-4"><span class="flex-none w-8 h-8 rounded-full bg-messing text-forst-dark font-semibold flex items-center justify-center">2</span><span><strong class="text-forst">Fachliche Ersteinordnung</strong> — sobald wir aus der Krone sind. Erhaltenswert? Fällpflicht? Preisrahmen? Alles ehrlich beantwortet.</span></li>
          <li class="flex gap-4"><span class="flex-none w-8 h-8 rounded-full bg-messing text-forst-dark font-semibold flex items-center justify-center">3</span><span><strong class="text-forst">Regionale Genehmigung</strong> — je nach Kommune (Norderstedt, Kaltenkirchen, Bad Segeberg, Quickborn …) unterschiedliche Schwellen. Wir kennen die zuständigen Behörden.</span></li>
          <li class="flex gap-4"><span class="flex-none w-8 h-8 rounded-full bg-messing text-forst-dark font-semibold flex items-center justify-center">4</span><span><strong class="text-forst">Ausführung nach ZTV-Baumpflege</strong> — Kletter- oder Krantechnik, versichert. Grundstück wird übergeben, nicht verlassen.</span></li>
        </ol>
        <div class="mt-8 pt-6 border-t border-forst/10 flex justify-center">
          <a href="https://wa.me/491771583264?text=Hallo%2C%20ich%20br%C3%A4uchte%20eine%20Baum-Einsch%C3%A4tzung." class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-messing text-forst-dark font-semibold text-body-sm no-underline hover:bg-messing-dark transition-colors">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.66 15.03L2 22l5.14-1.35A10 10 0 1 0 12 2Zm0 18.18a8.14 8.14 0 0 1-4.16-1.14l-.3-.18-3.06.8.82-2.98-.2-.31A8.18 8.18 0 1 1 12 20.18Zm4.71-6.14c-.26-.13-1.54-.76-1.78-.85-.24-.09-.41-.13-.58.13-.17.26-.66.85-.81 1.02-.15.17-.3.19-.55.06-.26-.13-1.1-.4-2.09-1.28-.77-.68-1.28-1.53-1.44-1.79-.15-.26-.02-.4.11-.53.11-.11.26-.3.39-.44.13-.15.17-.26.26-.43.09-.17.04-.32-.02-.45-.06-.13-.58-1.4-.79-1.92-.21-.5-.42-.44-.58-.44l-.5-.01c-.17 0-.44.06-.67.32-.23.26-.88.86-.88 2.1s.9 2.43 1.03 2.6c.13.17 1.78 2.72 4.32 3.81.6.26 1.08.41 1.45.53.61.19 1.16.17 1.6.1.49-.07 1.54-.63 1.75-1.24.22-.61.22-1.13.15-1.24-.07-.11-.24-.17-.5-.3Z"/></svg>
            Jetzt WhatsApp-Ersteinschätzung
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- WAS TIMBER MACHT -->
  <section class="section-padding-sm">
    <div class="container-site">
      <div class="max-w-2xl">
        <span class="eyebrow">Was wir machen</span>
        <h2 class="mt-4">Fünf Kernbereiche.<br/><span class="text-moos">Ein Anspruch.</span></h2>
      </div>

      <div class="mt-14 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {LEISTUNGEN.map((l) => (
          <a href={`/leistungen/#${l.slug}`} class="panel group no-underline">
            <span class="rule"></span>
            <h3 class="text-forst group-hover:text-messing-dark transition-colors" style="font-size: 1.5rem;">{l.name}</h3>
            <p class="mt-3 text-rauch text-body-sm leading-relaxed">{l.short}</p>
            <span class="mt-6 inline-block text-caption text-moos font-semibold uppercase tracking-widest group-hover:text-messing-dark transition-colors">Details →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- EINSATZGEBIETE -->
  <section class="section-padding bg-forst-dark text-birke">
    <div class="container-site">
      <div class="flex flex-wrap items-end justify-between gap-6 mb-14">
        <div class="max-w-xl">
          <span class="eyebrow text-messing">Einsatzgebiete</span>
          <h2 class="mt-4 text-birke">Wir arbeiten in ganz Norddeutschland.<br/><span class="text-messing italic font-normal">Kern-Einzugsgebiet: Kreis Segeberg &amp; Kreis Pinneberg.</span></h2>
        </div>
        <a href="/preisrechner/" class="btn-ghost border-birke/40 text-birke hover:bg-birke hover:text-forst">Preis schätzen →</a>
      </div>
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {STAEDTE.map((s) => (
          <a href={`/${s.slug}/`} class="group block border border-birke/10 p-8 no-underline hover:border-messing/40 transition-colors">
            <span class="text-caption uppercase tracking-widest text-messing">{s.region}</span>
            <h3 class="mt-2 text-birke group-hover:text-messing transition-colors" style="font-size: 1.5rem;">Baumpflege {s.name}</h3>
            <p class="mt-4 text-body-sm text-birke/60 leading-relaxed">{s.kurz}</p>
            <div class="mt-6 flex items-center justify-between">
              <span class="text-caption text-messing font-semibold uppercase tracking-widest">Zum Standort →</span>
              <span class="text-caption text-birke/50">Anfahrt {s.anfahrt}</span>
            </div>
          </a>
        ))}
      </div>
      <p class="mt-10 text-caption text-birke/60 text-center">
        Weiteres Einzugsgebiet Kiel, Lübeck, Rendsburg, Neumünster, Elmshorn: <a href="/schleswig-holstein/" class="text-messing underline">Regions-Übersicht Schleswig-Holstein →</a>
      </p>
    </div>
  </section>

  <!-- HALTUNG / MANIFESTO -->
  <section class="section-padding bg-birke-dark border-y border-linie">
    <div class="container-narrow text-center">
      <span class="eyebrow">Unsere Haltung</span>
      <h2 class="mt-4 text-forst">Wir sind gegen den <span class="italic">schnellen Kahlschlag</span>.</h2>
      <p class="mt-8 text-body-lg text-tinte/75 leading-relaxed mx-auto">
        Baumfällung ist der letzte Schritt, nicht der erste. Wo ein Baum durch Kronenpflege, Sicherungsschnitt oder ein Kronensicherungssystem gerettet werden kann, retten wir ihn. Ein Altbaum ersetzt sich nicht in einem Menschenleben. Wenn gefällt werden muss — dann sauber, versichert, mit Vollentsorgung. Sonst nicht.
      </p>
      <p class="mt-6 text-body text-rauch italic font-display">— TIMBER</p>
    </div>
  </section>

  <!-- WISSEN -->
  <section class="section-padding">
    <div class="container-site">
      <div class="flex flex-wrap items-end justify-between gap-6 mb-14">
        <div class="max-w-xl">
          <span class="eyebrow">Wissen aus der Krone</span>
          <h2 class="mt-4">Was Du vor dem Anruf wissen solltest.<br/><span class="text-moos">Ehrlich, ohne Verkaufsspin.</span></h2>
        </div>
        <a href="/wissen/" class="btn-ghost">Alle Ratgeber →</a>
      </div>

      <div class="grid gap-6 md:grid-cols-2">
        {WISSEN.map((w) => (
          <a href={`/wissen/${w.slug}/`} class="group block panel no-underline">
            <span class="rule"></span>
            <h3 class="text-forst group-hover:text-messing-dark transition-colors" style="font-size: 1.375rem;">{w.title}</h3>
            <p class="mt-4 text-body-sm text-rauch leading-relaxed">{w.short}</p>
            <span class="mt-6 inline-block text-caption text-moos font-semibold uppercase tracking-widest group-hover:text-messing-dark transition-colors">Weiterlesen →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- REFERENZ-VORSCHAU -->
  <section class="section-padding bg-forst-dark text-birke">
    <div class="container-site">
      <div class="flex flex-wrap items-end justify-between gap-6 mb-14">
        <div>
          <span class="eyebrow text-messing">Was wir bearbeiten</span>
          <h2 class="mt-4 text-birke">Typische Fälle.</h2>
        </div>
        <a href="/referenzen/" class="btn-ghost border-birke/40 text-birke hover:bg-birke hover:text-forst">Alle Einsatztypen →</a>
      </div>

      <div class="grid gap-6 md:grid-cols-2">
        {EINSATZTYPEN.slice(0, 4).map((r) => (
          <article class="border border-birke/10 p-8 hover:border-messing/40 transition-colors">
            <div class="mb-3">
              <span class="text-caption uppercase tracking-widest text-messing">{r.kategorie}</span>
            </div>
            <h3 class="text-birke" style="font-size: 1.5rem;">{r.title}</h3>
            <p class="mt-4 text-birke/70 text-body-sm leading-relaxed">{r.short}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- KONTAKT-CTA -->
  <section class="section-padding-sm bg-messing text-forst-dark">
    <div class="container-narrow text-center">
      <h2 class="text-forst-dark">Baum-Situation prüfen lassen?</h2>
      <p class="mt-6 text-body-lg mx-auto">Ruf einfach an. Oder schreib. Wir schauen uns Fotos vorab an — meist reicht das, um Aufwand und Kosten einzuschätzen.</p>
      <div class="mt-10 flex flex-wrap gap-4 justify-center">
        <a href={`tel:${CONTACT.phone}`} class="btn-primary">☎ {CONTACT.phoneDisplay}</a>
        <a href="/kontakt/" class="btn-ghost">Nachricht schreiben →</a>
      </div>
    </div>
  </section>

</BaseLayout>
