---
import BaseLayout from '../layouts/BaseLayout.astro';
import { CONTACT, STAEDTE, localBusinessSchema, waLink, mailB64 } from '../config';

const stadt = STAEDTE.find((s) => s.slug === 'henstedt-ulzburg')!;
const schema = localBusinessSchema(stadt);

const ortsteile = [
  { name: 'Henstedt', kurz: 'Alter Dorf­kern, gemischte Bebauung, Alt­bestand Buche und Eiche entlang der Hauptstraße.' },
  { name: 'Ulzburg', kurz: 'Zwischen Bahnhof und Alster­quelle, viele Einfamilien­häuser der 70er mit ausgewachsenen Gärten.' },
  { name: 'Ulzburg-Süd', kurz: 'Wohn­gebiet an der AKN-Trasse, dichter Bestand, teils Nadel­gehölze aus den 80ern.' },
  { name: 'Rhen', kurz: 'Villen­lage am Rhener Moor, alte Kiefern und Birken auf sandigem Boden.' },
  { name: 'Götzberg', kurz: 'Ortsteil im Westen, ländlich geprägt, Hofbäume und Alleen.' },
  { name: 'Kaden', kurz: 'Ortsteil im Osten Richtung Wakendorf, alte Eichen an Feld­rändern.' },
];

const faq = [
  {
    frage: 'Was kostet eine Baumfällung in Henstedt-Ulzburg?',
    antwort: 'Grobricht­werte: 10–15 m gut zugänglich zwischen 400 und 900 € netto, 25 m in enger Hinterhof-Lage 2.000–4.000 €. Nutze den <a href="/preisrechner/" class="text-moos underline">Preisrechner</a> für eine erste Einordnung — oder schick zwei Fotos plus Adresse per WhatsApp.',
  },
  {
    frage: 'Genehmigung — was gilt in Henstedt-Ulzburg?',
    antwort: 'Henstedt-Ulzburg hat eine Baumschutz­satzung im Rahmen der Segeberger Kreis­regelung. Geschützt sind Laubbäume ab 60 cm Stamm­umfang in 1 m Höhe. Antrag stellen wir für Dich beim Bau­amt. Vogel­schutz­frist § 39 BNatSchG (1. März–30. September) gilt zusätzlich für erhebliche Rückschnitte.',
  },
  {
    frage: 'Wie schnell seid ihr in Henstedt-Ulzburg vor Ort?',
    antwort: 'Sehr schnell — Anfahrt vom Standort in Nahe ist rund 10 Minuten. Bei Sturm-Notfall meist innerhalb einer Stunde am Einsatzort, sofern keine Priorität woanders liegt.',
  },
  {
    frage: 'Rahmen­vertrag für unsere Wohnungs­eigentümer­gemeinschaft?',
    antwort: 'Ja — FLL-Kontrollen einmal jährlich, digitales Baum­kataster mit Fotos und Handlungs­empfehlung, jederzeit abrufbar. Für WEG-Beiräte in Henstedt-Ulzburg ist das der wichtigste Haftungs­schutz.',
  },
  {
    frage: 'Auch Obstbaum­schnitt in Klein­gärten?',
    antwort: 'Ja, gern. Winter­schnitt (Januar–Februar) für Auf­bau und Ertrag, Sommer­schnitt (Juli–August) für Kronen­beruhigung. Keine Mindest­auftrags­größe — auch für einen einzelnen Baum kommen wir.',
  },
];
---

<BaseLayout
  title="Baumpflege Henstedt-Ulzburg — Baumfällung, Kronenpflege, Sturm-Notdienst"
  description="Baumpflege und Baumfällung in Henstedt-Ulzburg. Seilklettertechnik SKT-A/B, ZTV-Baumpflege, Baumschutzsatzung Kreis Segeberg. Henstedt, Ulzburg, Rhen, Götzberg, Kaden. Anfahrt nur 10 Minuten, Sturm-Notdienst 24/7."
  schema={schema}
>

  <section class="bg-forst-dark text-birke">
    <div class="container-site section-padding-sm">
      <span class="eyebrow text-messing">Einsatzgebiet · Henstedt-Ulzburg · Kreis Segeberg</span>
      <h1 class="mt-4 text-birke max-w-3xl leading-[1.05]">Baumpflege in Henstedt-Ulzburg.<br/><span class="text-messing italic font-normal">Der schnellste Weg — 10 Minuten Anfahrt.</span></h1>
      <p class="mt-8 text-body-lg text-birke/70 max-w-2xl leading-relaxed">
        Henstedt-Ulzburg ist der Ort, in den wir am schnellsten kommen. Unser Standort liegt in Nahe an der Segeberger Straße — Luftlinie sind es keine sieben Kilometer bis zum Ulzburger Bahnhof. Für Sturm-Notfälle heißt das: meist unter einer Stunde vor Ort. Für Termin­einsätze heißt es: wir können auch kurzfristige Sicht­kontrollen einplanen, ohne dass der halbe Tag draufgeht.
      </p>
      <div class="mt-10 flex flex-wrap gap-4">
        <a href={waLink()} class="btn-messing" target="_blank" rel="noopener"><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.66 15.03L2 22l5.14-1.35A10 10 0 1 0 12 2Zm0 18.18a8.14 8.14 0 0 1-4.16-1.14l-.3-.18-3.06.8.82-2.98-.2-.31A8.18 8.18 0 1 1 12 20.18Zm4.71-6.14c-.26-.13-1.54-.76-1.78-.85-.24-.09-.41-.13-.58.13-.17.26-.66.85-.81 1.02-.15.17-.3.19-.55.06-.26-.13-1.1-.4-2.09-1.28-.77-.68-1.28-1.53-1.44-1.79-.15-.26-.02-.4.11-.53.11-.11.26-.3.39-.44.13-.15.17-.26.26-.43.09-.17.04-.32-.02-.45-.06-.13-.58-1.4-.79-1.92-.21-.5-.42-.44-.58-.44l-.5-.01c-.17 0-.44.06-.67.32-.23.26-.88.86-.88 2.1s.9 2.43 1.03 2.6c.13.17 1.78 2.72 4.32 3.81.6.26 1.08.41 1.45.53.61.19 1.16.17 1.6.1.49-.07 1.54-.63 1.75-1.24.22-.61.22-1.13.15-1.24-.07-.11-.24-.17-.5-.3Z"/></svg> Fotos per WhatsApp</a>
        <a data-mb={mailB64()} href="/kontakt/" class="btn-ghost border-birke/40 text-birke hover:bg-birke hover:text-forst"><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M4 6h16a2 2 0 0 1 2 2v.4l-10 5.6L2 8.4V8a2 2 0 0 1 2-2zm18 4.35V18a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2v-7.65l10 5.62 10-5.62z"/></svg> Fotos per E-Mail</a>
        <a href="/preisrechner/" class="btn-ghost border-birke/40 text-birke hover:bg-birke hover:text-forst">Preis schätzen →</a>
      </div>
      <div class="mt-10 flex flex-wrap gap-x-8 gap-y-3 text-caption text-birke/60 uppercase tracking-widest">
        <span>SKT-A/B im Team</span>
        <span>·</span>
        <span>ZTV-Baumpflege</span>
        <span>·</span>
        <span>Anfahrt 10 Min</span>
      </div>
    </div>
  </section>

  <section class="section-padding">
    <div class="container-narrow prose-longform">
      <span class="eyebrow">Was Henstedt-Ulzburg besonders macht</span>
      <h2 class="mt-4">Wachstum, Fahrrad­stadt, drei Böden.</h2>

      <p class="mt-8 text-body-lg text-tinte/85 leading-relaxed">
        Henstedt-Ulzburg ist mit über 28.000 Einwohnern die größte Gemeinde Schleswig-Holsteins — offiziell keine Stadt, faktisch eine. Was das für den Baumbestand bedeutet: viele Ein­familien­haus-Siedlungen aus drei Jahrzehnten (70er, 80er, 2000er), unterschied­liche Böden je nach Ortsteil, und ein sehr aktives Anwohner-Klima rund um Baum­fragen. In Henstedt-Ulzburg wird Baum­schutz ernster genommen als in vielen anderen Segeberger Gemeinden — das prägt auch, wie wir arbeiten.
      </p>

      <p class="mt-6 text-body text-tinte/80 leading-relaxed">
        <strong>Drei typische Bodensituationen:</strong> Der Ortsteil Rhen liegt am Rhener Moor — sandig, feucht, mit Kiefern, Birken und Erlen. Ulzburg und Henstedt-Zentrum haben lehmige Böden, viel Buche, Eiche und Ahorn. Götzberg und Kaden im Westen und Osten sind ländlicher geprägt, mit Hofbäumen und Alleen entlang der Feld­wege. Wer Baum­probleme hat, hat sie oft baum­art-typisch — Kiefer­n mit einseitiger Krone am Moor­rand, Buchen mit Riesen­porling in Ulzburg, Fichten mit Käfer in Götzberg.
      </p>

      <p class="mt-6 text-body text-tinte/80 leading-relaxed">
        <strong>Wachstums­dynamik:</strong> Henstedt-Ulzburg wächst weiter. Neue Bau­gebiete werden erschlossen, ältere Gärten werden nach­verdichtet, Reihen­häuser stehen enger zusammen. Das erhöht die Bedeutung von Kletter­kompetenz — viele Fällungen sind schlicht nicht mehr mit Kran erreichbar, weil zwischen den Häusern zwei Meter Zwischen­raum bleiben.
      </p>

      <p class="mt-6 text-body text-tinte/80 leading-relaxed">
        <strong>Baumschutz­satzung:</strong> Wie im gesamten Kreis Segeberg üblich sind Laubbäume ab 60 cm Stamm­umfang in 1 m Höhe geschützt. Für Fällungen brauchst Du eine Genehmigung durch das Bau­amt der Gemeinde. Ausnahmen: Obstbäume (außer Walnuss und Esskastanie), Bäume in Klein­gärten unter bestimmten Bedingungen, akute Gefahr. Ohne Genehmigung fällen ist vierstellig teuer plus vor­geschriebene Ersatz­pflanzung.
      </p>
    </div>
  </section>

  <section class="section-padding bg-birke-dark border-y border-linie">
    <div class="container-site">
      <div class="max-w-2xl">
        <span class="eyebrow">Ortsteile</span>
        <h2 class="mt-4">Wo wir in Henstedt-Ulzburg arbeiten.</h2>
      </div>
      <div class="mt-12 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        {ortsteile.map((ot) => (
          <div class="panel">
            <span class="rule"></span>
            <h3 class="text-forst" style="font-size: 1.15rem;">{ot.name}</h3>
            <p class="mt-3 text-body-sm text-rauch leading-relaxed">{ot.kurz}</p>
          </div>
        ))}
      </div>
      <p class="mt-12 text-caption text-rauch">
        Nachbar­gemeinden im gleichen Radius: <a href="/norderstedt/" class="text-moos underline">Norderstedt</a> · <a href="/kaltenkirchen/" class="text-moos underline">Kaltenkirchen</a> · <a href="/bad-segeberg/" class="text-moos underline">Bad Segeberg</a> · <a href="/quickborn/" class="text-moos underline">Quickborn</a> · Wakendorf II · Nützen · Alveslohe
      </p>
    </div>
  </section>

  <section class="section-padding">
    <div class="container-site">
      <div class="max-w-2xl">
        <span class="eyebrow">Leistungen in Henstedt-Ulzburg</span>
        <h2 class="mt-4">Was wir hier am häufigsten machen.</h2>
      </div>
      <div class="mt-14 grid gap-8 md:grid-cols-2">
        <div class="border border-linie p-8">
          <h3 class="text-forst" style="font-size: 1.35rem;">Baumfällung — mit Antrag</h3>
          <p class="mt-4 text-body-sm text-rauch leading-relaxed">
            Vom einzelnen Reihen­haus-Baum bis zur Reihen­fällung im Neu­bau­gebiet. Wir prüfen die Genehmigungs­fähigkeit, stellen den Antrag beim Bau­amt Henstedt-Ulzburg und arbeiten in der Vegetations­ruhe. Zerlegung von oben mit Seilkletter­technik ist Standard, Kran oder MEWP wo Zugang möglich.
          </p>
        </div>
        <div class="border border-linie p-8">
          <h3 class="text-forst" style="font-size: 1.35rem;">Kronen­pflege & Kronen­sicherung</h3>
          <p class="mt-4 text-body-sm text-rauch leading-relaxed">
            Für die Alt­buchen in Ulzburg und Henstedt-Zentrum ist Kronen­sicherung (Cobra, Boa) oft die richtige Antwort — nicht die Fällung. Ein 100-jähriger Baum lässt sich in der Regel für weitere Jahrzehnte statisch sichern.
          </p>
        </div>
        <div class="border border-linie p-8">
          <h3 class="text-forst" style="font-size: 1.35rem;">FLL-Baumkontrolle & Kataster</h3>
          <p class="mt-4 text-body-sm text-rauch leading-relaxed">
            Rahmen­verträge mit Verwaltungen, WEG-Beiräten und der Gemeinde für Regel­kontrolle nach FLL-Baumkontroll­richtlinie. Digitaler Kataster­aufbau, Fotodokumentation, Handlungs­empfehlung — rechtsfest im Haftungs­fall.
          </p>
        </div>
        <div class="border border-linie p-8">
          <h3 class="text-forst" style="font-size: 1.35rem;">Sturm-Notdienst 24/7</h3>
          <p class="mt-4 text-body-sm text-rauch leading-relaxed">
            Henstedt-Ulzburg ist unser nächst­gelegener Ortsteil außerhalb Nahes — in der Regel unter einer Stunde vor Ort. Personen­gefahr immer zuerst 112, danach uns.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section-padding bg-forst-dark text-birke">
    <div class="container-narrow prose-longform">
      <span class="eyebrow text-messing">Kurze Wege</span>
      <h2 class="mt-4 text-birke">10 Minuten — was das praktisch heißt.</h2>
      <p class="mt-8 text-body-lg text-birke/80 leading-relaxed">
        Wenn Du in Henstedt-Ulzburg wohnst und Baum­probleme hast, ist die Anfahrts­zeit unser stärkster Vorteil. Ein Baumkletterer aus Hamburg braucht 45 Minuten für die Hin­fahrt, wir zehn. Das rechnet sich für Dich in mehreren Punkten:
      </p>
      <ul class="mt-8 space-y-3 text-body text-birke/75 leading-relaxed">
        <li>· <strong>Sturm-Notfall:</strong> Personen­gefährdung wird meist in der ersten Stunde entschieden — kurze Anfahrt heißt größere Chance auf schaden­freie Sicherung.</li>
        <li>· <strong>Angebots­termin:</strong> Wir kommen für einen 20-Minuten-Ortstermin gern vorbei, ohne dass sich das für keine Seite rechnet.</li>
        <li>· <strong>Genehmigungs­abwicklung:</strong> Kurze Wege zum Bau­amt — wir kennen die Ansprech­partner und wissen, was üblicher­weise verlangt wird.</li>
        <li>· <strong>Nach­kontrolle:</strong> Nach einer Kronen­sicherung oder Fällung ist eine Sicht­kontrolle nach 6–12 Monaten sinnvoll — bei Dir vor der Haustür kein Aufwand.</li>
      </ul>
    </div>
  </section>

  <section class="section-padding">
    <div class="container-narrow">
      <span class="eyebrow">Häufige Fragen</span>
      <h2 class="mt-4">Was Kunden in Henstedt-Ulzburg fragen.</h2>
      <div class="mt-12 space-y-4">
        {faq.map((f) => (
          <details class="border border-linie p-6">
            <summary class="font-display font-medium text-forst cursor-pointer text-body">{f.frage}</summary>
            <p class="mt-4 text-body-sm text-rauch leading-relaxed" set:html={f.antwort}></p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="section-padding bg-messing text-forst-dark">
    <div class="container-narrow text-center">
      <h2 class="text-forst-dark">Henstedt-Ulzburg — 10 Minuten von hier.</h2>
      <p class="mt-6 text-body-lg mx-auto max-w-xl">
        Ruf an oder schick eine WhatsApp mit Foto und Adresse. Kostenlose Einschätzung binnen 24 Stunden.
      </p>
      <div class="mt-10 flex flex-wrap gap-4 justify-center">
        <a href={waLink()} class="btn-primary" target="_blank" rel="noopener"><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.66 15.03L2 22l5.14-1.35A10 10 0 1 0 12 2Zm0 18.18a8.14 8.14 0 0 1-4.16-1.14l-.3-.18-3.06.8.82-2.98-.2-.31A8.18 8.18 0 1 1 12 20.18Zm4.71-6.14c-.26-.13-1.54-.76-1.78-.85-.24-.09-.41-.13-.58.13-.17.26-.66.85-.81 1.02-.15.17-.3.19-.55.06-.26-.13-1.1-.4-2.09-1.28-.77-.68-1.28-1.53-1.44-1.79-.15-.26-.02-.4.11-.53.11-.11.26-.3.39-.44.13-.15.17-.26.26-.43.09-.17.04-.32-.02-.45-.06-.13-.58-1.4-.79-1.92-.21-.5-.42-.44-.58-.44l-.5-.01c-.17 0-.44.06-.67.32-.23.26-.88.86-.88 2.1s.9 2.43 1.03 2.6c.13.17 1.78 2.72 4.32 3.81.6.26 1.08.41 1.45.53.61.19 1.16.17 1.6.1.49-.07 1.54-.63 1.75-1.24.22-.61.22-1.13.15-1.24-.07-.11-.24-.17-.5-.3Z"/></svg> Fotos per WhatsApp</a>
        <a data-mb={mailB64()} href="/kontakt/" class="btn-ghost"><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M4 6h16a2 2 0 0 1 2 2v.4l-10 5.6L2 8.4V8a2 2 0 0 1 2-2zm18 4.35V18a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2v-7.65l10 5.62 10-5.62z"/></svg> Fotos per E-Mail</a>
        <a href="/kontakt/" class="btn-ghost">Nachricht →</a>
      </div>
    </div>
  </section>

</BaseLayout>
