---
import BaseLayout from '../layouts/BaseLayout.astro';
import { CONTACT, LEISTUNGEN } from '../config';
---

<BaseLayout
  title="Leistungen"
  description="Was TIMBER macht: Baumfällung, Baumpflege, Verkehrssicherungspflicht, Sturm-Notdienst, Stubbenfräsen. Buchung erfolgt regional über unsere Einsatzgebiets-Auftritte."
>

  <section class="bg-forst-dark text-birke">
    <div class="container-site section-padding-sm">
      <span class="eyebrow text-messing">Leistungen</span>
      <h1 class="mt-4 text-birke max-w-3xl leading-[1.05]">Fünf Kernbereiche.<br/><span class="text-messing italic font-normal">Alles aus einer Hand.</span></h1>
      <p class="mt-8 text-body-lg text-birke/70 max-w-2xl leading-relaxed">
        TIMBER bündelt Baumarbeit vom einzelnen Sicherungsschnitt bis zum Sturm-Notdienst. Diese Seite gibt einen Überblick — für Angebot oder Termin ruf an oder schreib. Wir arbeiten in ganz Norddeutschland.
      </p>
    </div>
  </section>

  <section class="section-padding">
    <div class="container-site space-y-24">
      {LEISTUNGEN.map((l, i) => (
        <article id={l.slug} class="grid gap-10 lg:grid-cols-[1fr_1.6fr] lg:items-start scroll-mt-24">
          <div>
            <div class="font-display text-7xl text-messing italic leading-none">0{i + 1}</div>
            <h2 class="mt-4">{l.name}</h2>
          </div>
          <div>
            <p class="text-body-lg text-forst leading-relaxed font-medium">{l.short}</p>
            <p class="mt-6 text-body text-tinte/80 leading-relaxed">{l.long}</p>

            {l.slug === 'baumfaellung' && (
              <ul class="mt-8 space-y-2.5 text-body-sm text-rauch">
                <li>· Seilklettertechnik SKT-B in engen Lagen</li>
                <li>· Zerlegung von oben nach unten, Segment für Segment abgelassen</li>
                <li>· MEWP-/Krananbindung nach Situation</li>
                <li>· Ganzheitliche Entsorgung — Stamm, Krone, Schnittgut</li>
              </ul>
            )}
            {l.slug === 'baumpflege' && (
              <ul class="mt-8 space-y-2.5 text-body-sm text-rauch">
                <li>· Kronenpflege nach ZTV-Baumpflege</li>
                <li>· Kronenreduktion, Kronenauslichtung</li>
                <li>· Totholzentfernung</li>
                <li>· Dynamische Kronensicherung (Cobra, Boa)</li>
                <li>· Obstbaumschnitt (Winter- und Sommerschnitt)</li>
              </ul>
            )}
            {l.slug === 'verkehrssicherheit' && (
              <ul class="mt-8 space-y-2.5 text-body-sm text-rauch">
                <li>· Regelbaumkontrolle nach FLL-Richtlinie</li>
                <li>· Baumkataster-Aufbau und -Pflege</li>
                <li>· Gutachterliche Einschätzung bei Verdacht auf Bruchgefahr</li>
                <li>· Rechtsfeste Dokumentation für den Haftungsfall</li>
                <li>· Rahmenverträge für Verwaltungen und Kommunen</li>
              </ul>
            )}
            {l.slug === 'sturmdienst' && (
              <div class="mt-8 panel-dark">
                <div class="text-caption uppercase tracking-widest text-messing">Sturm-Notdienst</div>
                <div class="mt-3 font-display text-2xl text-birke">☎ {CONTACT.phoneDisplay}</div>
                <p class="mt-3 text-body-sm text-birke/70">Bei Personengefährdung immer zuerst 112. Danach uns.</p>
              </div>
            )}
            {l.slug === 'stubbenfraesen' && (
              <ul class="mt-8 space-y-2.5 text-body-sm text-rauch">
                <li>· Handgeführte Fräse für enge Zufahrten</li>
                <li>· Radlader-Fräse für große Stubben</li>
                <li>· Fräs-Tiefe 30–40 cm unter Rasenniveau</li>
                <li>· Entsorgung der Frässpäne oder Verbleib vor Ort</li>
              </ul>
            )}
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- KONTAKT-CTA -->
  <section class="section-padding bg-messing text-forst-dark">
    <div class="container-narrow text-center">
      <span class="eyebrow text-forst-dark/70">Angebot & Termin</span>
      <h2 class="mt-4 text-forst-dark">Kurzer Draht. Ohne Umweg.</h2>
      <p class="mt-6 text-body-lg mx-auto max-w-xl">
        Ruf an, schreib per WhatsApp oder E-Mail. Wir schauen uns den Baum entweder vor Ort an oder anhand Deiner Fotos — Angebot in der Regel binnen 24 Stunden.
      </p>
      <div class="mt-10 flex flex-wrap gap-4 justify-center">
        <a href={`tel:${CONTACT.phone}`} class="btn-primary">☎ {CONTACT.phoneDisplay}</a>
        <a href="/kontakt/" class="btn-ghost">Nachricht →</a>
      </div>
    </div>
  </section>

</BaseLayout>
