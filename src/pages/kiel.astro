---
import BaseLayout from '../layouts/BaseLayout.astro';
import { CONTACT, STAEDTE, localBusinessSchema } from '../config';

const stadt = STAEDTE.find((s) => s.slug === 'kiel')!;
const schema = localBusinessSchema(stadt);
---

<BaseLayout
  title="Baumpflege Kiel — Baumfällung & Kronensicherung an der Förde"
  description="Baumdienst in Kiel und Umland. Seilklettertechnik, Baumpflege nach ZTV, FLL-Baumkontrolle, Sturm-Notdienst. Von Düsternbrook über die Wik bis Elmschenhagen. Vollversichertes Fachteam aus Norddeutschland."
  schema={schema}
>

  <section class="bg-forst-dark text-birke">
    <div class="container-site section-padding-sm">
      <span class="eyebrow text-messing">Einsatzgebiet · Kiel</span>
      <h1 class="mt-4 text-birke max-w-3xl leading-[1.05]">Baumpflege in Kiel.<br/><span class="text-messing italic font-normal">Fördenklima, Küstenwind, alter Bestand.</span></h1>
      <p class="mt-8 text-body-lg text-birke/70 max-w-2xl leading-relaxed">
        Kiel ist geprägt von Wind. Die Förde saugt jede Brise ins Stadtgebiet, und was am Baum morsch ist, findet ein Herbststurm zuverlässig. Wir fahren nach Kiel für Fällungen an schwierigen Lagen, für Kronen­sicherung an alten Beständen in Düsternbrook und für den Sturm-Notdienst nach jeder größeren Wetterlage.
      </p>
      <div class="mt-10 flex flex-wrap gap-4">
        <a href={`tel:${CONTACT.phone}`} class="btn-messing">☎ {CONTACT.phoneDisplay}</a>
        <a href="/preisrechner/" class="btn-ghost border-birke/40 text-birke hover:bg-birke hover:text-forst">Preis schätzen →</a>
      </div>
    </div>
  </section>

  <section class="section-padding">
    <div class="container-narrow prose-longform">
      <span class="eyebrow">Kiel & Umland</span>
      <h2 class="mt-4">Wo wir arbeiten.</h2>
      <p class="mt-8 text-body-lg text-tinte/85 leading-relaxed">
        Kernstadt: <strong>Düsternbrook</strong> (Villen­lage mit Alt­buchen), <strong>Wik</strong>, <strong>Ravensberg</strong>, <strong>Blücherplatz</strong>, <strong>Elmschenhagen</strong> im Osten, <strong>Hassee</strong> und <strong>Suchsdorf</strong> im Westen. Umland: Eckernförde, Preetz, Plön, Rendsburg — wir kommen dorthin, wo Sturm und Alt­bestand aufeinander­treffen.
      </p>
      <p class="mt-6 text-body text-tinte/80 leading-relaxed">
        <strong>Baumschutz in Kiel:</strong> Die Landes­hauptstadt hat eine Baumschutz­satzung. Geschützt sind Laubbäume ab einem Stamm­umfang von 60 cm in 1 m Höhe sowie besondere Nadel­gehölze. Fällungs­anträge stellen wir für Dich.
      </p>
      <p class="mt-6 text-body text-tinte/80 leading-relaxed">
        <strong>Was hier besonders ist:</strong> Salzhaltige Luft, Wind aus wechselnden Richtungen und schwerer Lehmboden im Osten. Buchen und Eichen zeigen häufiger Zwiesel­brüche, weil einseitige Belastung durch Küsten­wind mit den Jahren die Statik schiebt. Kronen­sicherung ist bei Alt­bäumen an der Förde regel­mäßig sinnvoller als Fällung.
      </p>
    </div>
  </section>

  <section class="section-padding bg-birke-dark border-y border-linie">
    <div class="container-site">
      <div class="max-w-2xl">
        <span class="eyebrow">Leistungen in Kiel</span>
        <h2 class="mt-4">Fünf Kernbereiche, ein Team.</h2>
      </div>
      <div class="mt-12 grid gap-6 md:grid-cols-2">
        <div class="border border-linie bg-birke p-8">
          <h3 class="text-forst" style="font-size: 1.35rem;">Baumfällung</h3>
          <p class="mt-4 text-body-sm text-rauch leading-relaxed">Seilkletter­technik, Segment-Ablass, MEWP/Kran nach Zugang. Genehmigung inklusive.</p>
        </div>
        <div class="border border-linie bg-birke p-8">
          <h3 class="text-forst" style="font-size: 1.35rem;">Baumpflege nach ZTV</h3>
          <p class="mt-4 text-body-sm text-rauch leading-relaxed">Kronen­pflege, Reduktion, Totholz. Der Elb­hang-Ansatz auch an der Förde: Erhalten geht vor Ersetzen.</p>
        </div>
        <div class="border border-linie bg-birke p-8">
          <h3 class="text-forst" style="font-size: 1.35rem;">Kronen­sicherung</h3>
          <p class="mt-4 text-body-sm text-rauch leading-relaxed">Dynamische Systeme (Cobra, Boa) für Zwiesel und Rissbildung — statt Rückschnitt-Kahlschlag.</p>
        </div>
        <div class="border border-linie bg-birke p-8">
          <h3 class="text-forst" style="font-size: 1.35rem;">Sturm-Notdienst 24/7</h3>
          <p class="mt-4 text-body-sm text-rauch leading-relaxed">Nach Herbst­stürmen priorisiert nach Personen­gefährdung. Personen­gefahr zuerst 112.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section-padding bg-messing text-forst-dark">
    <div class="container-narrow text-center">
      <h2 class="text-forst-dark">Fördenklima. Handwerk aus dem Norden.</h2>
      <p class="mt-6 text-body-lg mx-auto max-w-xl">
        Anfahrt Kiel: eine gute Stunde von unserem Standort in Nahe. Termin­einsätze mit ein bis drei Wochen Vorlauf, Notfall so schnell wie möglich.
      </p>
      <div class="mt-10 flex flex-wrap gap-4 justify-center">
        <a href={`tel:${CONTACT.phone}`} class="btn-primary">☎ {CONTACT.phoneDisplay}</a>
        <a href="/kontakt/" class="btn-ghost">Nachricht →</a>
      </div>
    </div>
  </section>

</BaseLayout>
