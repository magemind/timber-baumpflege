---
import BaseLayout from '../layouts/BaseLayout.astro';
import { CONTACT, REFERENZEN } from '../config';
---

<BaseLayout
  title="Referenzen"
  description="Dokumentierte TIMBER-Projekte: Sturmfällung in Blankenese, Kronensicherung in Ahrensburg, Riesenporling-Buche in Pinneberg, Käferfichten im Kreis Pinneberg."
>

  <section class="bg-forst-dark text-birke">
    <div class="container-site section-padding-sm">
      <span class="eyebrow text-messing">Referenzen</span>
      <h1 class="mt-4 text-birke max-w-3xl leading-[1.05]">Aus der Praxis.<br/><span class="text-messing italic font-normal">Dokumentierte Projekte.</span></h1>
      <p class="mt-8 text-body-lg text-birke/70 max-w-2xl leading-relaxed">
        Vier ausgewählte Projekte aus den letzten zwei Jahren. Ohne Kundennamen (Datenschutz) — aber mit dem, was den Einsatz besonders macht.
      </p>
    </div>
  </section>

  <section class="section-padding">
    <div class="container-site">
      <div class="grid gap-10 md:grid-cols-2">
        {REFERENZEN.map((r) => (
          <article class="panel p-8">
            <div class="flex items-baseline justify-between mb-4">
              <span class="text-caption uppercase tracking-widest text-messing-dark">{r.location}</span>
              <span class="text-caption text-rauch">{r.year}</span>
            </div>
            <h2 class="text-forst" style="font-size: 1.5rem;">{r.title}</h2>
            <p class="mt-5 text-body text-tinte/80 leading-relaxed">{r.short}</p>
          </article>
        ))}
      </div>

      <div class="mt-16 panel-dark text-center">
        <span class="eyebrow text-messing">Referenz-Check</span>
        <h2 class="mt-4 text-birke" style="font-size: 1.75rem;">Ähnlicher Fall bei Dir?</h2>
        <p class="mt-4 text-body text-birke/70 max-w-xl mx-auto">Wenn Du einen Baum hast, der Dich an eines dieser Projekte erinnert — schick uns ein Foto. Meist reicht das für eine erste Einschätzung.</p>
        <div class="mt-8 flex flex-wrap gap-4 justify-center">
          <a href={`tel:${CONTACT.phone}`} class="btn-messing">☎ {CONTACT.phoneDisplay}</a>
          <a href="/kontakt/" class="btn-ghost border-birke/40 text-birke hover:bg-birke hover:text-forst">Foto senden →</a>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>
