---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppPill from '../components/WhatsAppPill.astro';
import { SITE, ORG_SCHEMA } from '../config';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  schema?: object;
  noIndex?: boolean;
}

const {
  title,
  description,
  canonical = Astro.url.href,
  schema,
  noIndex = false,
} = Astro.props;

const fullTitle = title === 'Startseite'
  ? `${SITE.legalName} — ${SITE.tagline}`
  : `${title} | ${SITE.name}`;

const finalSchema = schema ?? ORG_SCHEMA;
---

<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  {noIndex && <meta name="robots" content="noindex, nofollow" />}
  <link rel="canonical" href={canonical} />

  <link rel="preload" href="/fonts/Fraunces-Variable.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/Inter-Variable.woff2" as="font" type="font/woff2" crossorigin />

  <meta property="og:type" content="website" />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:locale" content="de_DE" />
  <meta property="og:site_name" content={SITE.name} />

  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <script type="application/ld+json" set:html={JSON.stringify(finalSchema)} />
</head>
<body class="min-h-dvh flex flex-col bg-birke text-tinte">
  <Header />
  <main class="flex-1 pt-[74px]">
    <slot />
  </main>
  <Footer />
  <WhatsAppPill />
</body>
</html>
