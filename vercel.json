{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "tdm-reservation",
          "value": "1"
        },
        {
          "key": "tdm-policy",
          "value": "https://timber-baumpflege.de/impressum/"
        }
      ]
    }
  ]
}
